-- Update the info panel on the right when a craft is selected
local function UpdateInfoFrame(itemName)
	local itemData = BlacksmithList[itemName]
	if itemData then
		-- Throttle inventory fetches to once every 6 seconds
		if not inventoryCooldown then
			inventoryCooldown = true
			task.delay(6, function()
				inventoryCooldown = false
			end)
			inventory = GetInventoryRemote:InvokeServer(true)
		end

		InfoFrame.Amount.Text = "$ " .. GeneralFunctions.addSpaces(itemData.Price)
		InfoFrame.Description.Text = itemData.Description
		InfoFrame.Title.Text = itemName

		-- Show all children except SelectedThing and UICorner
		for _, child in pairs(InfoFrame:GetChildren()) do
			if not table.find({"SelectedThing", "UICorner"}, child.Name) then
				child.Visible = true
			end
		end

		-- Show requirement item slots (up to 4)
		for i = 1, 4 do
			local slot = InfoFrame:FindFirstChild("Item" .. tostring(i))
			if itemData.Requirements[i] then
				local img = slot.ImageLabel
				local assetId = itemData.Requirements[i]
				img.Image = "https://www.roblox.com/asset-thumbnail/image?assetId="
					.. tostring(assetId)
					.. "&width=420&height=420&format=png"
				slot.Check.Visible = table.find(inventory, itemData.Requirements[i]) ~= nil
				slot.Visible = true
			else
				slot.Visible = false
			end
		end

		-- Toggle equip/buy buttons based on ownership
		local isOwned = table.find(ownedCrafts, itemName) ~= nil
		local hasRobuxOption = itemData.p2w ~= nil

		InfoFrame.EquipButton.Visible = isOwned
		InfoFrame.BuyButton.Visible = not isOwned
		InfoFrame.RobuxButton.Visible = not isOwned and hasRobuxOption
		InfoFrame.orLabel.Visible = not isOwned and hasRobuxOption

		if hasRobuxOption then
			local robuxLabel = InfoFrame.RobuxButton.TextLabel
			local robuxIcon = utf8.char(57346)
			local price = robuxPrices[itemData.p2w] or "..."
			robuxLabel.Text = robuxIcon .. tostring(price)
		end

		-- Equip/unequip button text
		if isOwned then
			local otherValues = localPlayer:WaitForChild("OtherValues")
			if otherValues.EquippedCraft.Value == itemName then
				InfoFrame.EquipButton.TextLabel.Text = "Unequip"
			else
				InfoFrame.EquipButton.TextLabel.Text = "Equip"
			end
		end

		-- Owned count label
		local ownedLabel = BlacksmithFrame.OwnedLabel
		local totalItems = #ScrollingFrame:GetChildren() - 2 -- subtract Template and UIListLayout
		ownedLabel.Text = tostring(#ownedCrafts) .. "/" .. tostring(totalItems)
	else
		-- Nothing selected — hide everything
		for _, child in pairs(InfoFrame:GetChildren()) do
			if not table.find({"SelectedThing", "UICorner"}, child.Name) then
				child.Visible = false
			end
		end
	end
end

-- Resize the scrolling list dynamically
local function SortList()
	local itemCount = #ScrollingFrame:GetChildren() - 2
	local scalePerItem = Template.Size.Y.Scale
	local totalScale = math.max(1, itemCount * (1 / scalePerItem)) * scalePerItem
	ScrollingFrame.CanvasSize = UDim2.new(0, 0, ScrollingFrame.Size.Y.Scale * totalScale, 0)

	for _, child in pairs(ScrollingFrame:GetChildren()) do
		if child.Name ~= "Template" and child:IsA("Frame") then
			child.Size = UDim2.new(Template.Size.X.Scale, 0, Template.Size.Y.Scale / math.max(1, itemCount * scalePerItem), 0)
		end
	end
end

-- Add a craft entry to the scrolling list
local function UpdateCraft(craftName)
	local craftData = BlacksmithList[craftName]
	if craftData then
		if not ScrollingFrame:FindFirstChild(craftName) then
			local entry = Template:Clone()
			entry.Name = craftName
			entry.TextButton.Description.Text = craftData.Description
			entry.TextButton.Title.Text = craftName
			entry.LayoutOrder = craftData.Order
			entry.Visible = true
			entry.Parent = ScrollingFrame

			entry.TextButton.MouseButton1Click:Connect(function()
				InfoFrame.SelectedThing.Value = craftName
			end)
		end

		SortList()

		local ownedLabel = BlacksmithFrame.OwnedLabel
		local totalItems = #ScrollingFrame:GetChildren() - 2
		ownedLabel.Text = tostring(#ownedCrafts) .. "/" .. tostring(totalItems)
	end
end

